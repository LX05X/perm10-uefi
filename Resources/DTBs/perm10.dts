/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Yupik IDP";
	compatible = "qcom,yupik-idp", "qcom,yupik", "qcom,idp";
	qcom,msm-id = <0x1db 0x10000 0x203 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x22 0x00>;
	oplus,dtsi_no = <0x5463 0x546c 0x524f 0x5253 0x548b 0x592f>;

	chosen {
		bootargs = "log_buf_len=2M earlycon=msm_geni_serial,0x994000 rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x37500000 0x00 0xc0000000 0x01 0x40000000 0x02 0x00 0x01 0x80000000>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x319>;

		kboot_uboot_logmem: kboot_uboot_logmem@0x9FE00000 {
			phandle = <0x6ba>;
			no-map;
			xbluefi-offset = <0x1f7000>;
			compatible = "oppo,xbl_uefi_kbootlog";
			reg = <0x00 0x9fe00000 0x00 0x200000>;
		};

		hyp_mem: hyp@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x31a>;
		};

		xbl_aop_mem: xbl_aop_mem@80700000 {
			no-map;
			reg = <0x00 0x80700000 0x00 0x160000>;
			phandle = <0x31b>;
		};

		cmd_db: cmd_db@80860000 {
			compatible = "qcom,cmd-db";
			no-map;
			reg = <0x00 0x80860000 0x00 0x20000>;
			phandle = <0x31c>;
		};

		reserved_xbl_uefi: reserved_xbl_uefi@80880000 {
			no-map;
			reg = <0x00 0x80880000 0x00 0x14000>;
			phandle = <0x31d>;
		};

		secdata_apss_mem: secdata_apss@808ff000 {
			no-map;
			reg = <0x00 0x808ff000 0x00 0x1000>;
			phandle = <0x31e>;
		};

		smem_mem: smem@80900000 {
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0xca>;
		};

		fw_mem: fw@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
			phandle = <0x31f>;
		};

		wlan_fw_mem: wlan_fw@80c00000 {
			no-map;
			reg = <0x00 0x80c00000 0x00 0xc00000>;
			phandle = <0x38>;
		};

		cdsp_secure_heap_mem: cdsp_secure_heap@81800000 {
			no-map;
			reg = <0x00 0x81800000 0x00 0x00>;
			phandle = <0x1e4>;
		};

		pil_cvp_mem: camera@86200000 {
			no-map;
			reg = <0x00 0x86200000 0x00 0x500000>;
			phandle = <0x320>;
		};

		pil_adsp_mem: adsp@86700000 {
			no-map;
			reg = <0x00 0x86700000 0x00 0x2800000>;
			phandle = <0xe6>;
		};

		pil_cdsp_mem: cdsp@88f00000 {
			no-map;
			reg = <0x00 0x88f00000 0x00 0x1e00000>;
			phandle = <0xe9>;
		};

		adsp_mem: adsp_region {
			no-map;
			compatible = "removed-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			phandle = <0xf0>;
		};

		pil_camera_mem: video@8ad00000 {
			no-map;
			reg = <0x00 0x8ad00000 0x00 0x500000>;
			phandle = <0x2e9>;
		};

		pil_video_mem: cvp@8b200000 {
			no-map;
			reg = <0x00 0x8b200000 0x00 0x500000>;
			phandle = <0x34>;
		};

		pil_ipa_fw_mem: ipa_fw@8b700000 {
			no-map;
			reg = <0x00 0x8b700000 0x00 0x10000>;
			phandle = <0x321>;
		};

		pil_ipa_gsi_mem: ipa_gsi@8b710000 {
			no-map;
			reg = <0x00 0x8b710000 0x00 0xa000>;
			phandle = <0xf1>;
		};

		pil_gpu_micro_code_mem: gpu_micro_code@8b71a000 {
			no-map;
			reg = <0x00 0x8b71a000 0x00 0x2000>;
			phandle = <0x302>;
		};

		pil_mpss_mem: mpss@8b800000 {
			no-map;
			reg = <0x00 0x8b800000 0x00 0xf600000>;
			phandle = <0xe1>;
		};

		pil_wpss_mem: wlan@9ae00000 {
			no-map;
			reg = <0x00 0x9ae00000 0x00 0x1900000>;
			phandle = <0xd3>;
		};

		removed_mem: removed_region@c0000000 {
			no-map;
			reg = <0x00 0xc0000000 0x00 0x5100000>;
			phandle = <0x322>;
		};

		pil_trustedvm_mem: pil_trustedvm_region@d0800000 {
			no-map;
			phandle = <0xdc>;
		};

		qrtr_shbuf: qrtr-shmem {
			no-map;
			reg = <0x00 0xd7ef7000 0x00 0x9000>;
			phandle = <0xdf>;
		};

		chan0_shbuf: neuron_block@0 {
			no-map;
			reg = <0x00 0xd7f00000 0x00 0x80000>;
			phandle = <0xdd>;
		};

		chan1_shbuf: neuron_block@1 {
			no-map;
			reg = <0x00 0xd7f80000 0x00 0x80000>;
			phandle = <0xde>;
		};

		user_contig_mem: user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x1e7>;
		};

		qseecom_mem: qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x1b>;
		};

		non_secure_display_memory: non_secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x6400000>;
			phandle = <0x1e9>;
		};

		splash_memory: splash_region {
			reg = <0x00 0xe1000000 0x00 0x2300000>;
			label = "cont_splash_region";
			phandle = <0x323>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x1e6>;
		};

		secure_display_memory: secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x8c00000>;
			phandle = <0x1e5>;
		};

		qcom: ramoops {
			ecc-size = <0x00>;
			rsv05info-size = <0x8000>;
			rsv04info-size = <0x8000>;
			rsv03info-size = <0x8000>;
			rsv02info-size = <0x8000>;
			rsv01info-size = <0x8000>;
			dumpinfo-size = <0x8000>;
			devinfo-size = <0x8000>;
			ftrace-size = <0x200000>;
			console-size = <0x40000>;
			record-size = <0x40000>;
			compatible = "ramoops";
			reg = <0x00 0xe9700000 0x00 0x5b8000>;
			pmsg-size = <0x200000>;
			mem-type = <0x02>;
			phandle = <0x324>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x6000000>;
			linux,cma-default;
		};

		dump_mem: mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x2c00000>;
			phandle = <0xed>;
		};

		audio_cma_mem: audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0x1e8>;
		};

		dfps_data_memory: dfps_data_memory {
			reg = <0x00 0xe3300000 0x00 0x100000>;
			label = "dfps_data_memory";
			phandle = <0x1c2>;
		};

		memshare_mem: memshare_region {
			compatible = "shared-dma-pool";
			no-map;
			alloc-ranges = <0x00 0x00 0x00 0xdfffffff>;
			alignment = <0x00 0x100000>;
			size = <0x00 0x800000>;
			phandle = <0x23>;
		};

		cnss_wlan_mem: cnss_wlan_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x325>;
		};
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
		mboxes = <0x02 0x00>;
	};

	aliases {
		ufshc1 = "/soc/ufshc@1d84000";
		sdhc0 = "/soc/sdhci@7C4000";
		sdhc1 = "/soc/sdhci@8804000";
		serial0 = "/soc/qcom,qup_uart@994000";
		hsuart0 = "/soc/qcom,qup_uart@99c000";
		swr0 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/wsa-macro@3240000/wsa_swr_master";
		swr1 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/rx-macro@3200000/rx_swr_master";
		swr2 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/tx-macro@3220000/tx_swr_master";
		i2c0 = "/soc/i2c@984000";
	};

	firmware: firmware {
		phandle = <0x326>;

		scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x03 0x13000>;
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,vendor_boot";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "ok";
				};
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x06 0x00 0x04>;
			next-level-cache = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x12>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x07>;

				L3_0: l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x08>;
				};
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x06 0x00 0x04>;
			next-level-cache = <0x09>;
			phandle = <0x13>;

			L2_1: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x09>;
			};
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x06 0x00 0x04>;
			next-level-cache = <0x0a>;
			phandle = <0x14>;

			L2_2: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x0a>;
			};
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x06 0x00 0x04>;
			next-level-cache = <0x0b>;
			phandle = <0x15>;

			L2_3: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x0b>;
			};
		};

		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			qcom,freq-domain = <0x06 0x01 0x04>;
			next-level-cache = <0x0e>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;

			L2_4: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x0e>;
			};
		};

		CPU5: cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			qcom,freq-domain = <0x06 0x01 0x04>;
			next-level-cache = <0x0f>;
			phandle = <0x17>;

			L2_5: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x0f>;
			};
		};

		CPU6: cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			qcom,freq-domain = <0x06 0x01 0x04>;
			next-level-cache = <0x10>;
			phandle = <0x18>;

			L2_6: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x10>;
			};
		};

		CPU7: cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d>;
			capacity-dmips-mhz = <0x7c1>;
			dynamic-power-coefficient = <0x228>;
			qcom,freq-domain = <0x06 0x02 0x04>;
			next-level-cache = <0x11>;
			#cooling-cells = <0x02>;
			phandle = <0x19>;

			L2_7: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x11>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core3 {
					cpu = <0x15>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x16>;
				};

				core1 {
					cpu = <0x17>;
				};

				core2 {
					cpu = <0x18>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x19>;
				};
			};
		};
	};

	sram: sram@18509400 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "mmio-sram";
		no-memory-wc;
		reg = <0x00 0x18509400 0x00 0x400>;
		ranges = <0x00 0x00 0x00 0x18509400 0x00 0x400>;
		phandle = <0x327>;

		cpu_scp_lpri: scp-shmem@0 {
			compatible = "arm,scp-shmem";
			reg = <0x00 0x00 0x00 0x80>;
			phandle = <0x5d>;
		};
	};

	soc: soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x328>;

		qcom,cam-res-mgr {
			status = "ok";
			compatible = "qcom,cam-res-mgr";
		};

		led_flash_rear_aux: qcom,camera-flash@1 {
			phandle = <0x669>;
			status = "ok";
			switch-source = <0x395>;
			torch-source = <0x38f>;
			flash-source = <0x38b>;
			compatible = "qcom,camera-flash";
			cell-index = <0x01>;
		};

		led_flash_rear: qcom,camera-flash@0 {
			phandle = <0x667>;
			status = "ok";
			switch-source = <0x395>;
			torch-source = <0x38f>;
			flash-source = <0x38b>;
			qcom,flash-current = <0x6e>;
			qcom,flash-name = "pmic";
			compatible = "qcom,camera-flash";
			reg = <0x00 0x00>;
			cell-index = <0x00>;
		};

		oplus_sensor: oplus_sensor {
			phandle = <0x6c6>;
			als-row-coe = <0x6e>;
			compatible = "oplus,sensor-devinfo";

			free_fall {
				is-virtual-sensor;
				sensor-type = <0x04>;
			};

			fp_display {
				prox-type = <0x00>;
				is-virtual-sensor;
				sensor-type = <0x03>;
			};

			lux_aod {
				als-type = <0x00>;
				thrd-high = <0x12c>;
				thrd-low = <0x1e>;
				is-virtual-sensor;
				sensor-type = <0x01>;
			};

			pickup_detect {
				prox-type = <0x00>;
				is-need-prox = <0x01>;
				is-virtual-sensor;
				sensor-type = <0x00>;
			};

			psensor@1 {
				cal_offset_margin = <0xbb8>;
				cali_jitter_limit = <0x14>;
				force_cali_limit = <0x7d0>;
				offset_range_max = <0xffff>;
				offset_range_min = <0x00>;
				offset_max = <0xea60>;
				raw2offset_radio = <0x3e8>;
				dynamic_cali_max = <0x1388>;
				anti_shake_delta = <0x46>;
				step_div = <0x5dc>;
				step_min = <0x64>;
				step_max = <0x190>;
				sampling_count = <0x05>;
				ps_adjust_max = <0x73a>;
				ps_adjust_min = <0x00>;
				ps_ir_limit = <0x7d0>;
				ps_dirty_limit = <0x708>;
				dirty_high_step = <0x190>;
				dirty_low_step = <0x12c>;
				high_limit = <0x41a>;
				low_limit = <0x28a>;
				high_step = <0x190>;
				low_step = <0x12c>;
				is_ps_initialzed = <0x00>;
				ps-type = <0x01>;
				ps-cail-type = <0x01>;
				irq-number = <0x8e>;
				bus-number = <0x02>;
				sensor-type = <0x04>;
				sensor-index = <0x01>;
				sensor-name = <0x01>;
			};

			psensor@0 {
				cali_jitter_limit = <0x14>;
				offset_max = <0xea60>;
				raw2offset_radio = <0x3e8>;
				dynamic_cali_max = <0x1388>;
				anti_shake_delta = <0x46>;
