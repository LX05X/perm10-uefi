						config {
							pins = "gpio8";
							drive-strength = <0x02>;
							bias-disable;
							output-low;
						};
					};

					cdc_dmic23_data_active: dmic23_data_active {
						phandle = <0x272>;

						mux {
							pins = "gpio9";
							function = "func1";
						};

						config {
							pins = "gpio9";
							drive-strength = <0x08>;
							input-enable;
						};
					};

					cdc_dmic23_data_sleep: dmic23_data_sleep {
						phandle = <0x274>;

						mux {
							pins = "gpio9";
							function = "func1";
						};

						config {
							pins = "gpio9";
							drive-strength = <0x02>;
							pull-down;
							input-enable;
						};
					};

					cdc_dmic45_clk_active: dmic45_clk_active {
						phandle = <0x275>;

