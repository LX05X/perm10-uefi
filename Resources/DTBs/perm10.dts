					reg = <0x4700 0x100>;
					interrupts = <0x03 0x47 0x00 0x00 0x03 0x47 0x01 0x00 0x03 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0xc3>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0xc7>;
				};

				pm7250b_vib: qcom,vibrator@df00 {
					status = "disabled";
					compatible = "qcom,qpnp-vibrator-ldo";
					reg = <0xdf00>;
					qcom,vib-ldo-volt-uv = <0x2dc6c0>;
					qcom,disable-overdrive;
					phandle = <0x398>;
				};

				pm7325b_lcdb: qcom,lcdb@fd00 {
					qcom,pwrdn-delay-ms = <0x04>;
					status = "ok";
					compatible = "qcom,lcdb-pm7325b";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0xfd00>;
					interrupts = <0x03 0xfd 0x01 0x01>;
					interrupt-names = "sc-irq";
					phandle = <0x399>;

					lcdb_ldo_vreg: ldo {
						label = "ldo";
						regulator-name = "lcdb_ldo";
						regulator-min-microvolt = <0x432380>;
						regulator-max-microvolt = <0x5b8d80>;
						phandle = <0x315>;
					};

					lcdb_ncp_vreg: ncp {
						label = "ncp";
						regulator-name = "lcdb_ncp";
						regulator-min-microvolt = <0x432380>;
						regulator-max-microvolt = <0x5b8d80>;
						phandle = <0x316>;
					};

					lcdb_bst_vreg: bst {
						label = "bst";
						regulator-name = "lcdb_bst";
						regulator-min-microvolt = <0x47b760>;
						regulator-max-microvolt = <0x61a800>;
						phandle = <0x39a>;
					};
				};

				pm7325b_wled: qcom,wled@d800 {
					qcom,ovp = <0x733c>;
					qcom,boost-current-limit = <0x4c9>;
					qcom,cabc-sel = <0x01>;
					status = "ok";
					compatible = "qcom,pm7325b-spmi-wled";
					reg = <0xfb00 0xfc00>;
					reg-names = "wled-ctrl-base", "wled-sink-base";
					label = "backlight";
					interrupts = <0x03 0xfb 0x01 0x01 0x03 0xfb 0x04 0x03 0x03 0xfb 0x05 0x03>;
					interrupt-names = "ovp-irq", "pre-flash-irq", "flash-irq";
					qcom,auto-calibration;
					qcom,string-cfg = <0x03>;
					qcom,leds-per-string = <0x08>;
					qcom,fs-current-limit = <0x61a8>;
					qcom,slew-ramp-time = <0x100>;
					qcom,exp-dimming-map = <0x1a 0x1b 0x1c 0x1d 0x1e 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2c 0x2d 0x2e 0x30 0x31 0x32 0x34 0x35 0x37 0x38 0x3a 0x3b 0x3d 0x3f 0x41 0x42 0x44 0x46 0x48 0x4a 0x4c 0x4f 0x51 0x53 0x55 0x58 0x5a 0x5d 0x60 0x62 0x65 0x68 0x6b 0x6e 0x71 0x74 0x77 0x7b 0x7e 0x82 0x86 0x89 0x8d 0x91 0x95 0x9a 0x9e 0xa2 0xa7 0xac 0xb1 0xb6 0xbb 0xc0 0xc5 0xcb 0xd1 0xd7 0xdd 0xe3 0xe9 0xf0 0xf7 0xfe 0x105 0x10c 0x114 0x11c 0x124 0x12c 0x135 0x13d 0x146 0x150 0x159 0x163 0x16d 0x177 0x182 0x18d 0x198 0x1a4 0x1b0 0x1bc 0x1c8 0x1d5 0x1e3 0x1f0 0x1fe 0x20d 0x21c 0x22b 0x23b 0x24b 0x25c 0x26d 0x27e 0x290 0x2a3 0x2b6 0x2ca 0x2de 0x2f3 0x308 0x31e 0x335 0x34c 0x364 0x37c 0x396 0x3b0 0x3ca 0x3e6 0x402 0x41f 0x43d 0x45c 0x47b 0x49c 0x4bd 0x4e0 0x503 0x527 0x54d 0x573 0x59b 0x5c3 0x5ed 0x618 0x644 0x672 0x6a0 0x6d0 0x702 0x735 0x769 0x79f 0x7d6 0x80f 0x849 0x885 0x8c3 0x903 0x944 0x987 0x9cc 0xa13 0xa5c 0xaa8 0xaf5 0xb44 0xb96 0xbea 0xc40 0xc99 0xcf5 0xd52 0xdb3 0xe16 0xe7d 0xee6 0xf52 0xfc1 0x1033 0x10a8 0x1121 0x119d 0x121d 0x12a1 0x1328 0x13b3 0x1441 0x14d4 0x156b 0x1607 0x16a6 0x174b 0x17f4 0x18a1 0x1954 0x1a0b 0x1ac8 0x1b8b 0x1c52 0x1d20 0x1df3 0x1ecc 0x1fab 0x2091 0x217d 0x2270 0x236a 0x246b 0x2573 0x2682 0x2799 0x28b9 0x29e0 0x2b10 0x2c48 0x2d89 0x2ed3 0x3027 0x3184 0x32eb 0x345c 0x35d8 0x375e 0x38f0 0x3a8d 0x3c35 0x3dea 0x3fab 0x4179 0x4353 0x453c 0x4732 0x4936 0x4b49 0x4d6b 0x4f9c 0x51dd 0x542f 0x5692 0x5905 0x5b8b 0x5e23 0x60cd 0x638b 0x665d 0x6944 0x6c3f 0x6f50 0x7277 0x75b5 0x790b 0x7c78 0x7fff>;
					phandle = <0x39b>;

					wled_flash: qcom,wled-flash {
						label = "flash";
						qcom,default-led-trigger = "wled_flash";
						phandle = <0x39c>;
					};

					wled_torch: qcom,wled-torch {
						label = "torch";
						qcom,default-led-trigger = "wled_torch";
						qcom,wled-torch-timer = <0x4b0>;
						phandle = <0x39d>;
					};

					wled_switch: qcom,wled-switch {
						label = "switch";
						qcom,default-led-trigger = "wled_switch";
						phandle = <0x39e>;
					};
				};
			};
		};

		spmi_debug_bus: qcom,spmi-debug@6b12000 {
			compatible = "qcom,spmi-pmic-arb-debug";
			reg = <0x6b12000 0x60 0x7820b0 0x04>;
			reg-names = "core", "fuse";
			clocks = <0x21 0x00>;
			clock-names = "core_clk";
			qcom,fuse-disable-bit = <0x18>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			status = "ok";
			phandle = <0x39f>;

			qcom,pmk8350-debug@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				qcom,can-sleep;
			};

			qcom,pm7325-debug@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				qcom,can-sleep;
			};

			qcom,pm8350c-debug@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				qcom,can-sleep;
			};

			qcom,pm8350b-debug@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				qcom,can-sleep;
			};

			qcom,pmr735a-debug@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				qcom,can-sleep;
			};
		};

