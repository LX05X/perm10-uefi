						qcom,is-reset;
						qcom,use-broadcast-timer;
						phandle = <0x05>;
					};
				};

				qcom,pm-cpu@1 {
					reg = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					qcom,psci-mode-shift = <0x00>;
					qcom,psci-mode-mask = <0x0f>;
					qcom,cpu = <0x16 0x17 0x18 0x19>;

					GOLD_WFI: qcom,pm-cpu-level@0 {
						reg = <0x00>;
