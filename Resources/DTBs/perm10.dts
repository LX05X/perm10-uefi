					};

					vooc_asic_id_active: vooc_asic_id_active {
						phandle = <0x64b>;
						power-source = <0x01>;
						input-enable;
						bias-pull-up;
						function = "normal";
						pins = "gpio7";
					};

					dischg_disable: dischg_disable {
						phandle = <0x63b>;
						qcom,drive-strength = <0x03>;
						output-low;
						power-source = <0x00>;
						bias-disable;
						function = "normal";
						pins = "gpio9";
					};

					dischg_enable: dischg_enable {
						phandle = <0x63a>;
						qcom,drive-strength = <0x03>;
