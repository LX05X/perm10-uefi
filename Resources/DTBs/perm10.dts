						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7325b_ref_gnd {
						reg = <0x300>;
						label = "pm7325b_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7325b_vref_1p25 {
						reg = <0x301>;
						label = "pm7325b_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7325b_die_temp {
