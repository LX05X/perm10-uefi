				pm7325_gpios: pinctrl@8800 {
					compatible = "qcom,pm7325-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x318>;

					pm7325_gpio2 {

						pm7325_gpio2_default: pm7325_gpio2_default {
							phandle = <0x5fa>;
							bias-high-impedance;
							pins = "gpio2";
						};
					};

					usbtemp_r_gpio_default: usbtemp_r_gpio_default {
						phandle = <0x642>;
						bias-high-impedance;
						function = "normal";
						pins = "gpio5";
					};

					usbtemp_l_gpio_default: usbtemp_l_gpio_default {
						phandle = <0x641>;
						bias-high-impedance;
						function = "normal";
						pins = "gpio3";
					};

					key_vol_down {

						key_vol_down_default: key_vol_down_default {
							phandle = <0x639>;
							power-source = <0x01>;
							bias-pull-up;
							input-enable;
							function = "normal";
							pins = "gpio6";
						};
					};

					key_vol_up {

						key_vol_up_default: key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x317>;
						};
					};
				};
