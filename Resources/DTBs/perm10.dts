		cam_csiphy0: qcom,csiphy0 {
			cell-index = <0x00>;
			compatible = "qcom,csiphy-v1.2.1", "qcom,csiphy";
			reg = <0xace0000 0x2000>;
			reg-names = "csiphy";
			reg-cam-base = <0xe0000>;
			interrupts = <0x00 0x1dd 0x01>;
			interrupt-names = "csiphy0";
			gdscr-supply = <0x2e0>;
			refgen-supply = <0x1b8>;
			csi-vdd-1p2-supply = <0x37>;
			csi-vdd-0p9-supply = <0x36>;
			regulator-names = "gdscr", "refgen", "csi-vdd-1p2", "csi-vdd-0p9";
			rgltr-cntrl-support;
			rgltr-min-voltage = <0x00 0x00 0x124f80 0xd6d80>;
			rgltr-max-voltage = <0x00 0x00 0x1339e0 0x100590>;
			rgltr-load-current = <0x00 0x00 0xd2f0 0x17890>;
			clocks = <0x2a 0x1f 0x2a 0x2a 0x2a 0x21 0x2a 0x20>;
			clock-names = "cphy_rx_clk_src", "csiphy0_clk", "csi0phytimer_clk_src", "csi0phytimer_clk";
			src-clock-name = "csi0phytimer_clk_src";
			clock-cntl-level = "lowsvs", "svs";
			clock-rates = <0x11e1a300 0x00 0x11e1a300 0x00 0x17d78400 0x00 0x11e1a300 0x00>;
			status = "ok";
			phandle = <0x5b8>;
		};

