					idle-state-name = "llcc-off";
					entry-latency-us = <0xe36>;
					exit-latency-us = <0x19a2>;
					min-residency-us = <0x2662>;
					arm,psci-suspend-param = <0xb340>;
					qcom,psci-mode = <0xb34>;
					qcom,is-reset;
					qcom,notify-rpm;
					qcom,min-child-idx = <0x02>;
					phandle = <0x4da>;
				};

				qcom,pm-cpu@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					qcom,psci-mode-shift = <0x00>;
					qcom,psci-mode-mask = <0x0f>;
					qcom,ref-stddev = <0x1f4>;
					qcom,tmr-add = <0x3e8>;
					qcom,ref-premature-cnt = <0x01>;
					qcom,disable-ipi-prediction;
					qcom,cpu = <0x12 0x13 0x14 0x15>;

					SLVR_WFI: qcom,pm-cpu-level@0 {
						reg = <0x00>;
						compatible = "arm,idle-state";
						idle-state-name = "wfi";
						entry-latency-us = <0x3d>;
						exit-latency-us = <0x3c>;
						min-residency-us = <0x79>;
						arm,psci-suspend-param = <0x01>;
						qcom,psci-cpu-mode = <0x01>;
						phandle = <0x4db>;
					};

					SLVR_OFF: qcom,pm-cpu-level@1 {
						reg = <0x01>;
						compatible = "arm,idle-state";
						idle-state-name = "pc";
						entry-latency-us = <0x225>;
						exit-latency-us = <0x385>;
						min-residency-us = <0x6ee>;
						arm,psci-suspend-param = <0x40000003>;
