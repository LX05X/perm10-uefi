				qcom,psci-mode-mask = <0xfff>;

				CLUSTER_WFI: qcom,pm-cluster-level@0 {
					reg = <0x00>;
					compatible = "arm,idle-state";
					idle-state-name = "l3-wfi";
					entry-latency-us = <0x294>;
					exit-latency-us = <0x258>;
					min-residency-us = <0x4ec>;
					arm,psci-suspend-param = <0x10>;
