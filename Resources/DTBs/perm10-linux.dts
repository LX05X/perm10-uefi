			interconnects = <0x45 0x06 0x00 0x07 0x01 0x00 0x06 0x02 0x00 0x46 0x1f 0x00>;
			interconnect-names = "sdhc-ddr", "cpu-sdhc";
			power-domains = <0x39 0x00>;
			operating-points-v2 = <0x47>;
			bus-width = <0x08>;
			supports-cqe;
