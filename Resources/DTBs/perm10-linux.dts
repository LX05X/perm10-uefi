	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x1aa>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x1ab>;
		pinctrl-names = "default";

		key-volume-down {
			label = "Volume Down";
			gpios = <0x175 0x06 0x01>;
			linux,code = <0x72>;
			wakeup-source;
			debounce-interval = <0x0f>;
		};
	};


	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		phandle = <0x17f>;
	};

	pmic-glink {
		compatible = "oplus,21031-pmic-glink", "qcom,sm7325-pmic-glink", "qcom,qcm6490-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x54 0x8c 0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x1b3>;
						phandle = <0x14f>;
					};
				};
			};
		};
	};

	smpa3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s2b_0p7";
		regulator-min-microvolt = <0xaae60>;
		regulator-max-microvolt = <0xaae60>;
		regulator-always-on;
		vin-supply = <0x17f>;
		phandle = <0x180>;
	};
};
