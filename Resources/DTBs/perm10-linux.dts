		sram@146a5000 {
			compatible = "qcom,sc7280-imem", "syscon", "simple-mfd";
			reg = <0x00 0x146a5000 0x00 0x6000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x146a5000 0x6000>;

			minidump-sram@1c {
				reg = <0x1c 0x04>;
				phandle = <0x23>;
			};

			modem-tables@3000 {
				reg = <0x3000 0x2000>;
				phandle = <0xe1>;
			};

			pil-reloc@594c {
				compatible = "qcom,pil-reloc-info";
				reg = <0x594c 0xc8>;
			};
		};

