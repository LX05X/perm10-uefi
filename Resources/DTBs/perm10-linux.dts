			dmic01-clk-state {
				pins = "gpio6";
				function = "dmic1_clk";
				drive-strength = <0x08>;
				bias-disable;
			};

			dmic01-data-state {
				pins = "gpio7";
				function = "dmic1_data";
				drive-strength = <0x08>;
				bias-pull-down;
			};

			dmic23-clk-state {
				pins = "gpio8";
				function = "dmic2_clk";
				drive-strength = <0x08>;
				bias-disable;
			};

			dmic23-data-state {
				pins = "gpio9";
				function = "dmic2_data";
				drive-strength = <0x08>;
				bias-pull-down;
			};

			i2s1-active-state {

				clk-pins {
					pins = "gpio6";
					function = "i2s1_clk";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
				};

				ws-pins {
					pins = "gpio7";
					function = "i2s1_ws";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
				};

				data-pins {
					pins = "gpio8", "gpio9";
					function = "i2s1_data";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
				};
			};

			i2s1-sleep-state {

				clk-pins {
					pins = "gpio6";
					function = "i2s1_clk";
					drive-strength = <0x02>;
					bias-pull-down;
					input-enable;
				};

				ws-pins {
					pins = "gpio7";
					function = "i2s1_ws";
					drive-strength = <0x02>;
					bias-pull-down;
					input-enable;
				};

				data-pins {
					pins = "gpio8", "gpio9";
					function = "i2s1_data";
					drive-strength = <0x02>;
					bias-pull-down;
					input-enable;
				};
			};

			i2s2-active-state {

				clk-pins {
					pins = "gpio10";
					function = "i2s2_clk";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
