/*
 * OPPO K10 Vitality (PERM10, SM7325 "Kodiak"/Walle) - Linux device tree.
 *
 * Derived from the working OPPO Reno7 (PFJM10) tree: the SoC description is
 * shared, the board specifics below were re-derived from the PERM10 605
 * firmware capture (Resources/DTBs/perm10.dtb) and the hardware inventory.
 * Still missing: a kernel panel driver for the ILI7807S, so display is
 * expected to stay dark until one is added.
 */
/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "OPPO K10 Vitality (PERM10)";
	compatible = "xiaomi,lisa", "qcom,sm7325";
	chassis-type = "handset";

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";
	};

	aliases {
		i2c0 = "/soc@0/geniqup@9c0000/i2c@980000";
		i2c1 = "/soc@0/geniqup@9c0000/i2c@984000";
		i2c2 = "/soc@0/geniqup@9c0000/i2c@988000";
		i2c3 = "/soc@0/geniqup@9c0000/i2c@98c000";
		i2c4 = "/soc@0/geniqup@9c0000/i2c@990000";
		i2c5 = "/soc@0/geniqup@9c0000/i2c@994000";
		i2c6 = "/soc@0/geniqup@9c0000/i2c@998000";
		i2c7 = "/soc@0/geniqup@9c0000/i2c@99c000";
		i2c8 = "/soc@0/geniqup@ac0000/i2c@a80000";
		i2c9 = "/soc@0/geniqup@ac0000/i2c@a84000";
		i2c10 = "/soc@0/geniqup@ac0000/i2c@a88000";
		i2c11 = "/soc@0/geniqup@ac0000/i2c@a8c000";
		i2c12 = "/soc@0/geniqup@ac0000/i2c@a90000";
		i2c13 = "/soc@0/geniqup@ac0000/i2c@a94000";
		i2c14 = "/soc@0/geniqup@ac0000/i2c@a98000";
		i2c15 = "/soc@0/geniqup@ac0000/i2c@a9c000";
		mmc1 = "/soc@0/mmc@7c4000";
		mmc2 = "/soc@0/mmc@8804000";
		spi0 = "/soc@0/geniqup@9c0000/spi@980000";
		spi1 = "/soc@0/geniqup@9c0000/spi@984000";
		spi2 = "/soc@0/geniqup@9c0000/spi@988000";
		spi3 = "/soc@0/geniqup@9c0000/spi@98c000";
		spi4 = "/soc@0/geniqup@9c0000/spi@990000";
		spi5 = "/soc@0/geniqup@9c0000/spi@994000";
		spi6 = "/soc@0/geniqup@9c0000/spi@998000";
		spi7 = "/soc@0/geniqup@9c0000/spi@99c000";
		spi8 = "/soc@0/geniqup@ac0000/spi@a80000";
		spi9 = "/soc@0/geniqup@ac0000/spi@a84000";
		spi10 = "/soc@0/geniqup@ac0000/spi@a88000";
		spi11 = "/soc@0/geniqup@ac0000/spi@a8c000";
		spi12 = "/soc@0/geniqup@ac0000/spi@a90000";
		spi13 = "/soc@0/geniqup@ac0000/spi@a94000";
		spi14 = "/soc@0/geniqup@ac0000/spi@a98000";
		spi15 = "/soc@0/geniqup@ac0000/spi@a9c000";
		serial0 = "/soc@0/geniqup@9c0000/serial@994000";
		serial1 = "/soc@0/geniqup@9c0000/serial@99c000";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x493e000>;
			#clock-cells = <0x00>;
			phandle = <0x17e>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7ffc>;
			#clock-cells = <0x00>;
			phandle = <0x35>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan-ce@4cd000 {
			no-map;
			reg = <0x00 0x4cd000 0x00 0x1000>;
			phandle = <0xd0>;
		};

		hyp@80000000 {
			reg = <0x00 0x80000000 0x00 0x600000>;
			no-map;
		};

		xbl@80600000 {
			reg = <0x00 0x80600000 0x00 0x200000>;
			no-map;
		};

		aop@80800000 {
			reg = <0x00 0x80800000 0x00 0x60000>;
			no-map;
		};

		aop-cmd-db@80860000 {
			reg = <0x00 0x80860000 0x00 0x20000>;
			compatible = "qcom,cmd-db";
			no-map;
		};

		xbl-uefi-res@80880000 {
			reg = <0x00 0x80884000 0x00 0x10000>;
			no-map;
		};

		sec-apps@808ff000 {
			reg = <0x00 0x808ff000 0x00 0x1000>;
			no-map;
		};

		smem@80900000 {
			reg = <0x00 0x80900000 0x00 0x200000>;
			no-map;
			phandle = <0x25>;
		};

		cpucp@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
		};

		wlan-fw@80c00000 {
			reg = <0x00 0x80c00000 0x00 0xc00000>;
			no-map;
			phandle = <0xcf>;
		};

		adsp@86700000 {
			reg = <0x00 0x86700000 0x00 0x4000000>;
			no-map;
			phandle = <0x142>;
		};

		ipa-fw@8b700000 {
			reg = <0x00 0x8b700000 0x00 0x10000>;
			no-map;
			phandle = <0xe0>;
		};

		zap@8b71a000 {
			reg = <0x00 0x8b71a000 0x00 0x2000>;
			no-map;
			phandle = <0xf8>;
		};

		mpss@8b800000 {
			reg = <0x00 0x8b800000 0x00 0xf600000>;
			no-map;
			phandle = <0xfc>;
		};

		wpss@9ae00000 {
			reg = <0x00 0x9ae00000 0x00 0x1900000>;
			no-map;
			phandle = <0x146>;
		};

		cdsp-secure-heap@81800000 {
			reg = <0x00 0x81800000 0x00 0x1e00000>;
			no-map;
		};

		video@8ad00000 {
			reg = <0x00 0x8ad00000 0x00 0x500000>;
			no-map;
			phandle = <0x154>;
		};

		ipa-gsi@8b710000 {
			reg = <0x00 0x8b710000 0x00 0xa000>;
			no-map;
		};

		cdsp@9c700000 {
			reg = <0x00 0x9c700000 0x00 0x1e00000>;
			no-map;
			phandle = <0x14c>;
		};

		adsp-rpc-remote-heap@9e500000 {
			reg = <0x00 0x9e500000 0x00 0x800000>;
			no-map;
			phandle = <0x144>;
		};

		ramoops@a9000000 {
			compatible = "ramoops";
			reg = <0x00 0xa9000000 0x00 0x200000>;
			record-size = <0x00>;
			console-size = <0x100000>;
			pmsg-size = <0x100000>;
			ecc-size = <0x10>;
		};

		removed@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x8e00000>;
			no-map;
		};

		pil-trustedvm-region@d0800000 {
			reg = <0x00 0xd0800000 0x00 0x76f7000>;
			no-map;
		};

		qrtr-shmem@d7ef7000 {
			reg = <0x00 0xd7ef7000 0x00 0x9000>;
			no-map;
		};

		neuron-block@d7f00000 {
			reg = <0x00 0xd7f00000 0x00 0x80000>;
			no-map;
		};

		neuron-block@d7f80000 {
			reg = <0x00 0xd7f80000 0x00 0x80000>;
			no-map;
		};

		rmtfs@ef500000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0xef500000 0x00 0x280000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f 0x2b>;
		};

		memory@8a700000 {
			reg = <0x00 0x8a700000 0x00 0x600000>;
			no-map;
		};

		memory@8b200000 {
			reg = <0x00 0x8b200000 0x00 0x500000>;
			no-map;
		};

		memory@8b71c000 {
			reg = <0x00 0x8b71c000 0x00 0xe4000>;
			no-map;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x00>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x03>;
			power-domain-names = "psci";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x04>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x09>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x100>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0a>;
			power-domain-names = "psci";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0b>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x200>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0c>;
			power-domain-names = "psci";
			next-level-cache = <0x0d>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0d>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x300>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0e>;
			power-domain-names = "psci";
			next-level-cache = <0x0f>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0f>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x400>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x10>;
			power-domain-names = "psci";
			next-level-cache = <0x11>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x11>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x500>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x13>;
			power-domain-names = "psci";
			next-level-cache = <0x14>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1f>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x14>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x600>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x15>;
			power-domain-names = "psci";
			next-level-cache = <0x16>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x20>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x16>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo670";
			reg = <0x00 0x700>;
			clocks = <0x02 0x02>;
			enable-method = "psci";
			power-domains = <0x17>;
			power-domain-names = "psci";
			next-level-cache = <0x18>;
			operating-points-v2 = <0x19>;
			capacity-dmips-mhz = <0x7c1>;
			dynamic-power-coefficient = <0x228>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x02>;
			#cooling-cells = <0x02>;
			phandle = <0x21>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x18>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1a>;
				};

				core1 {
					cpu = <0x1b>;
				};

				core2 {
					cpu = <0x1c>;
				};

				core3 {
					cpu = <0x1d>;
				};

				core4 {
					cpu = <0x1e>;
				};

				core5 {
					cpu = <0x1f>;
				};

				core6 {
					cpu = <0x20>;
				};

				core7 {
					cpu = <0x21>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "little-power-down";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x225>;
				exit-latency-us = <0x385>;
				min-residency-us = <0x6ee>;
				local-timer-stop;
				phandle = <0x29>;
			};

			cpu-sleep-0-1 {
				compatible = "arm,idle-state";
				idle-state-name = "little-rail-power-down";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x2be>;
				exit-latency-us = <0x393>;
				min-residency-us = <0xfa1>;
				local-timer-stop;
				phandle = <0x2a>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "big-power-down";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x20b>;
				exit-latency-us = <0x4dc>;
				min-residency-us = <0x89f>;
				local-timer-stop;
				phandle = <0x2b>;
			};

			cpu-sleep-1-1 {
				compatible = "arm,idle-state";
				idle-state-name = "big-rail-power-down";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x20e>;
				exit-latency-us = <0x73e>;
				min-residency-us = <0x15b3>;
				local-timer-stop;
				phandle = <0x2c>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0xac0>;
				exit-latency-us = <0xbe8>;
				min-residency-us = <0x17e6>;
				phandle = <0x2d>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41001344>;
				entry-latency-us = <0xcbf>;
				exit-latency-us = <0x11d2>;
				min-residency-us = <0x2113>;
				phandle = <0x2e>;
			};

			cluster-sleep-2 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100b344>;
				entry-latency-us = <0xe36>;
				exit-latency-us = <0x19a2>;
				min-residency-us = <0x2662>;
				phandle = <0x2f>;
			};
		};
	};

	opp-table-cpu0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x05>;

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			opp-peak-kBps = <0xc3500 0x927c00>;
		};

		opp-691200000 {
			opp-hz = <0x00 0x2932e000>;
			opp-peak-kBps = <0xc3500 0x10fe000>;
		};

		opp-806400000 {
			opp-hz = <0x00 0x3010b000>;
			opp-peak-kBps = <0xc3500 0x13ec000>;
		};

		opp-940800000 {
			opp-hz = <0x00 0x38137800>;
			opp-peak-kBps = <0x1b86e0 0x1770000>;
		};

		opp-1152000000 {
			opp-hz = <0x00 0x44aa2000>;
			opp-peak-kBps = <0x2162e0 0x19c8000>;
		};

		opp-1324800000 {
			opp-hz = <0x00 0x4ef6d800>;
			opp-peak-kBps = <0x2162e0 0x203a000>;
		};

		opp-1516800000 {
			opp-hz = <0x00 0x5a688800>;
			opp-peak-kBps = <0x2ee000 0x2454000>;
		};

		opp-1651200000 {
			opp-hz = <0x00 0x626b5000>;
			opp-peak-kBps = <0x2ee000 0x27d8000>;
		};

		opp-1804800000 {
			opp-hz = <0x00 0x6b931000>;
			opp-peak-kBps = <0x3e12a0 0x2e4a000>;
		};

		opp-1958400000 {
			opp-hz = <0x00 0x74bad000>;
			opp-peak-kBps = <0x3e12a0 0x2e4a000>;
		};

		opp-2016000000 {
			opp-hz = <0x00 0x7829b800>;
			opp-peak-kBps = <0x5ee8e0 0x2e4a000>;
		};
	};

	opp-table-cpu4 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x12>;

		opp-691200000 {
			opp-hz = <0x00 0x2932e000>;
			opp-peak-kBps = <0x1b86e0 0x927c00>;
		};

		opp-940800000 {
			opp-hz = <0x00 0x38137800>;
			opp-peak-kBps = <0x2162e0 0x10fe000>;
		};

		opp-1228800000 {
			opp-hz = <0x00 0x493e0000>;
			opp-peak-kBps = <0x3e12a0 0x1770000>;
		};

		opp-1344000000 {
			opp-hz = <0x00 0x501bd000>;
			opp-peak-kBps = <0x3e12a0 0x1770000>;
		};

		opp-1516800000 {
